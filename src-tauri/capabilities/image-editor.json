{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "image-editor",
  "description": "Image editor windows (image-editor-<id>): read and delete the temp image under $APPDATA/image-editor/, and close the window.",
  "windows": ["image-editor-*"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$APPDATA/image-editor/*" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "$APPDATA/image-editor/*" }]
    }
  ]
}
