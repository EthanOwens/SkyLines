# Firebase Configuration
# Get these values from: https://console.firebase.google.com
# Project Settings > General > Your apps > Web app > SDK setup and configuration

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Google Sign-In (system-browser + deep-link flow, spec.md subtask 21)
# Client ID of a "Desktop app"-type OAuth 2.0 client from Google Cloud
# Console (APIs & Services > Credentials), created under the GCP project
# backing this Firebase project. Must be "Desktop app" type, NOT
# "Web application" - Google's OAuth server rejects the custom
# `skylines://auth-callback` redirect URI for "Web application" clients
# (confirmed: see lib/auth/googleOAuth.ts for details). No client secret is
# needed here (implicit id_token flow).
NEXT_PUBLIC_GOOGLE_DESKTOP_OAUTH_CLIENT_ID=your_desktop_oauth_client_id.apps.googleusercontent.com
