# Firebase Configuration
# Get these values from: https://console.firebase.google.com
# Project Settings > General > Your apps > Web app > SDK setup and configuration

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Google Sign-In (system browser + loopback redirect, authorization code + PKCE)
# ID and secret of a "Desktop app"-type OAuth 2.0 client from Google Cloud
# Console (APIs & Services > Credentials). It needs no redirect URIs. Google
# allows installed apps to ship the secret.
NEXT_PUBLIC_GOOGLE_DESKTOP_OAUTH_CLIENT_ID=your_desktop_oauth_client_id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_DESKTOP_OAUTH_CLIENT_SECRET=your_desktop_oauth_client_secret
